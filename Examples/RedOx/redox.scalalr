/**
    A notation somewhat reminiscent of *occam* and of Ian Page's early *Handel*

    Provision for testing (see ParserTests.scala) from an IDE is made by
    adding two prefixes in the definition of top to indicate the exact kind of
    phrase to be parsed if that phrases in not a `declare`.
*/


%notation RedOx
%package  org.redox
%path     "org/redox"
%tables   ielr

%include {
   import org.sufrin.scalalr.{SourceLocation,ScannerCore,Scanner}
   import org.sufrin.utility.SourceTextCursor
   import org.sufrin.utility.PrettyPrint._


   /**
        `Scanner(chars)` builds a lexical scanner using a `ScannerBuilder`. The implementations of
        the `mkXXX` functions bridge the fixed lexical categories of the builder, and the `%token`
        constructors declared here. The `withSymbolTokens(symbolToken)` clause initialises the
        internal symbol and token tables of the resulting builder.
     */

       import collection.immutable.ListMap
       def hex(chars: Seq[Char]): Long  = chars.foldLeft(0L) { (acc, c) => acc * 16 + Character.digit(c, 16) }
       def dec(chars: Seq[Char]): Long  = chars.foldLeft(0L) { (acc, c) => acc * 10 + Character.digit(c, 10) }
       def toUpperCased(mapping: Map[String,Token]): ListMap[String,Token] = {
           ListMap.from(mapping.map { case (k, d) => (k.map(_.toUpper), d) })
       }

       // type Token = org.redox.Scanner.Token

       def makeScanner(chars: SourceTextCursor): Scanner[Token] =
           new ScannerCore[Token](chars) {
              def mkString(openQuote: String, CLOSEQuote: String, body: Seq[Char]): Token = STRING(s"$openQuote${body.mkString}$CLOSEQuote")
              def mkHex(source: Seq[Char]):         Token = NUM(hex(source))
              def mkDec(source: Seq[Char]):         Token = NUM(dec(source))
              def mkReal(source: Seq[Char]):        Token = SCANERROR(source.mkString)
              def mkIDENTIFIER(source: Seq[Char]):  Token = ID(source.mkString)
              def mkERROR(source: Seq[Char]):       Token = SCANERROR(source.mkString)
              val NEWLINE:                   Option[Token] = None
              override val ENDSTREAM: Token                = Scanner.ENDSTREAM
           } withSymbolTokens(toUpperCased(symbolToken))

}

%token NUM(Long) ID(String)  `(` `)` `[` `]` `,`  '.'  ':'  NL SCANERROR(String) STRING(String)
%token `if` `alt` `{` `}` `case` `?` `->` `!` `skip` `delay` `stop` `~` `=>`
%token `while` `until` `_` `for` `from` `repeat`
%token `:=` `seq`
%token `var` `int` `rom` `chan` `uint`

%prec ';'
%prec LOW


%right '||'
%right '&&'

%non  '|=' '<' '<=' '>' '>=' '=='

%left '$' // bitwise or
%left '^'
%left '&'
%left '++'


%left `+` `-`
%left `*`
%left 'for' 'from'

%prec HIGH

%rules

%include {
 import org.redox.AST._


 // disambiguate expr[expr]
 def mkBracket(l: Expr, r: Expr): Expr =
 { (l, r) match {
    case (Num(value, 0), Num(bits, 0)) =>  Num(value, bits)
    case (_, _) => Index(l, r)
   }
 }

 def mkPar(first: Proc, rest: List[Proc]): Proc =
     rest.size match {
            case 0 => SKIP
            case 1 => PAR(first, rest(0))
            case _ => Parallel(first::rest)
          }

 def mkWhile(guard: Expr, body: Seq[Proc]): Proc =
     body.size match {
       case 0 => While(guard, SKIP)
       case 1 => While(guard, body(0))
       case _ => While(guard, Sequence(body))
     }

 def mkUntil(guard: Expr, body: Seq[Proc]): Proc =
      body.size match {
        case 0 => Until(guard, SKIP)
        case 1 => Until(guard, body(0))
        case _ => Until(guard, Sequence(body))
      }

 def mkRepeat(body: Seq[Proc]): Proc =
        body.size match {
          case 0 => Repeat(SKIP)
          case 1 => Repeat(body(0))
          case _ => Repeat(Sequence(body))
        }
}

top: Proc = declare | "-" "proc" proc | "-" "expr" expr

declare: Proc = "declare" '{'  decls: (decl)* '}' body: proc { Declare($decls, $body)($START, $END) }

decl: Decl = "int"   ID '[' width: expr ']'  initially  (';')?  { Integer($ID,  $width, $initially) }
           | "uint"  ID '[' width: expr ']'  initially  (';')?  { Unsigned($ID, $width, $initially) }
           | "rom"   ID '[' expr ']' '{' exprs '}'      (';')?  { Rom($ID, $expr, $exprs) }
           | "chan"  ID '[' expr ']'                    (';')?  { Channel($ID, $expr) }
           | "macro" ID '=' expr                        (';')?  { Macro($ID, Nil, $expr) } %prec LOW
           | "macro" ID '(' formals: (formal ',')+  ')' '=' expr   (';')?  { Macro($ID, $formals, $expr) }

 proc: Proc = prim


 alt:  AltBranch  = '(' guard: expr ')' chan: ID  '?' lexpr '->' proc   { AltBranch($guard, $chan, $lexpr, $proc) };
 case: CaseBranch =  labels: (',' expr)+  '->' proc  { CaseBranch($labels, $proc) };
 if:   IfBranch   =  expr '->' proc  { IfBranch($expr, $proc) };

 procs:  List[Proc]      = '{' list: (proc ';')... '}' { $list };
 alts:   List[AltBranch] = '{' list: (alt ';')... '}' { $list };
 ifs:    List[IfBranch]  = '{' list: (if ';')... '}' { $list };
 cases:  List[CaseBranch]= '{' list: (case ';')... '}' { $list };

prim: Proc = lexprs: (',' expr)+  ':=' exprs   { Assign($lexprs, $exprs)($START, $END) }
           | chan: expr '?' lexpr: lexpr       { Read($chan, $lexpr) }
           | chan: expr '!' value: expr        { Write($chan, $value) }
           | `skip`                            { SKIP}
           | `delay`                           { DELAY}
           | `stop`                            { STOP }
           | "alt"         body: alts          { PriAlt($body)($START, $END) }
           | "if"          body: ifs           { If($body)($START, $END) }
           | "do"          body: ifs           { Do($body)($START, $END) }
           | "case" expr   body: cases         { Case($expr, $body)($START, $END) }
           | "while" expr  body: procs         { mkWhile($expr, $body) }
           | "until" expr  body: procs         { mkUntil($expr, $body) }
           | "repeat"      body: procs         { mkRepeat($body) }
           | "seq"         body: procs         { Sequence($body)($START, $END) }
           | "par"         body: procs         { Parallel($body)($START, $END) }
           | "{"  body: (proc ';')... "}"      { Sequence($body)($START, $END) }
           | declare




expr: Expr =
        | primExpr
        | l:primExpr `[` expr `]`   { mkBracket($l, $expr) }
        | l:expr `$` r:expr         { Binop("$", $l, $r)    ($START, $END) } // bitwise or
        | l:expr `^` r:expr         { Binop("^", $l, $r)    ($START, $END) }
        | l:expr `&` r:expr         { Binop("&", $l, $r)    ($START, $END) }
        | l:expr `*` r:expr         { Binop("*", $l, $r)    ($START, $END) }
        | l:expr `+` r:expr         { Binop("+", $l, $r)    ($START, $END) }
        | l:expr `++` r:expr        { Binop("++", $l, $r)   ($START, $END) }
        | l:expr `-` r:expr         { Binop("-", $l, $r)    ($START, $END) }
        | l:expr 'for'  r:expr      { Binop("for", $l, $r)  ($START, $END) }
        | l:expr 'from' r:expr      { Binop("from", $l, $r) ($START, $END) }
        | l:expr '&&' r: expr       { Binop("&&", $l, $r)   ($START, $END) }
        | l:expr '||'  r: expr      { Binop("||", $l, $r)   ($START, $END) }
        | l:expr `==` r:expr        { Binop("==", $l, $r)   ($START, $END) }
        | l:expr `|=` r:expr        { Binop("|=", $l, $r)   ($START, $END) }
        | l:expr `<=` r:expr        { Binop("<=", $l, $r)   ($START, $END) }
        | l:expr `>=` r:expr        { Binop(">=", $l, $r)   ($START, $END) }
        | l:expr `<` r:expr         { Binop("<", $l, $r)    ($START, $END) }
        | l:expr `>` r:expr         { Binop(">", $l, $r)    ($START, $END) }


primExpr: Expr =
        | constExpr
        | '~' primExpr        { Unop("~", $primExpr)($START, $END) } %prec HIGH
        | '-' primExpr        { Unop("-", $primExpr)($START, $END) } %prec HIGH
        | "(" expr ")"
        | ID  "(" exprs ")"   { Apply($ID, $exprs.reverse)($START, $END) } %prec `^`
        | '_'                 { Anything }
        | '('  guard: expr  '->' l: expr '|' r: condExpr ')' { Cond($guard, $l, $r)($START,$END) }


constExpr: Expr =
        | ID                  { Id($ID)($START, $END) }
        | value: NUM          { Num($value, 0)($START, $END) }

condExpr: Expr  = expr
                | guard: expr  '->' l: expr  {Cond($guard, $l, Anything)($START,$END)}
                | guard: expr  '->' l: expr '|' r: condExpr {Cond($guard, $l, $r)($START,$END)}

exprs: (List[Expr]) = (',' expr)*

lexpr: LExpr = ID  { Id($ID)($START, $END) }

formal: Id = ID { Id($ID)($START, $END) }

initially: List[Expr] = %empty    => List()
                      | ":=" expr => List($expr)

