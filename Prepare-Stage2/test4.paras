
%tables    ielr
%notation  stage2test
%package   scalalr.stage2test
%path      "parser"


%include { This is the inclusion }

%token A B C(D) E: F[G,H] Rule3
%token I J K
%left  '-'
%right '+:' '-:'


%rules

%include { Rules inclusion } 

Rule1: Unit = S1 S2 S3 { Code }

Rule2: Unit = a: S4 b: S5 { () }

Rule3: Unit = Rule1 "+" Rule2 { "sum" } | Rule2 "-" Rule1 { () }

Rule1: Unit = %empty

'+':S = FOO

/* Tail comment */
