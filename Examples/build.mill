package build

/**
 *  Build (small) example programs that use the ScalaLR parser generator
 */

import mill.*, scalalib.*

trait ComponentModule extends ScalaModule {
  def scalaVersion = "2.13.18"
   override def scalacOptions = Seq(
      "-deprecation",
      "-feature",
      "-unchecked"
    )
}

object TinyFun extends ScalalrModule with ComponentModule  {
  override
  def scalaVersion  = "2.13.18"
  def notation      = "tinyfun.scalalr"
  def unmanagedJars = "Assets"
  def scalalr       = "Assets/scalalr"
  def mainClass     = Some("runtinyfun")
  def releasePath = "tinyfun"
}

object RedOx extends ScalalrModule with ComponentModule {
  override
  def scalaVersion  = "2.13.18"
  def notation      = "redox.scalalr"
  def unmanagedJars = "Assets"
  def scalalr       = "Assets/scalalr"
  def mainClass     = Some("org.redox.RedOx")
  def releasePath   = "bin/redox"
  def generatorArgs = Seq("-html") //, "-Lsym", "-Lsyn")
}

object Calculator extends ScalalrModule with ComponentModule  {
  override
  def scalaVersion  = "2.13.18"
  def notation      = "calculator.scalalr"
  def unmanagedJars = "Assets"
  def scalalr       = "Assets/scalalr"
  def mainClass     = Some("Calculator")
  def releasePath   = "bin/calculator"
  def generatorArgs: Seq[String] = Seq(
  "-html",
  //"-Lsym",
  //"-Lsyn",
  //"-c"
  )


  override def moduleDeps = Seq()

  // we need the scala xml module
  def mvnDeps = Seq(
      mvn"org.scala-lang.modules::scala-xml:2.3.0"
  )
}


