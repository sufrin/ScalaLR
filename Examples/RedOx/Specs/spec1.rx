// Ian's microprocessor

DECLARE {
        INT   A[8];
        INT   PC[6];
        INT   IR[8];
        INT   Halt[1];
        CHAN  OUT[6];
        ROM   PROG[8] { 0, 65, 66, 67, 68, 69, 192, 0 };
        MACRO INSTRUCTION = IR FROM 6 // for 2 bits
        MACRO OPERAND     = IR FOR  6
}
SEQ {
  A    := 0[8];
  PC   := 0[6];
  Halt := 0[1];
  WHILE Halt == 0[1] {
        IR, PC := PROG[PC], PC + 1[6];
        CASE ( INSTRUCTION ) {              
            0 -> A := OPERAND;         
            1 -> A := A + OPERAND; 
            2 -> IF { A |= 0[8] -> PC := OPERAND  }; 
            3 -> Halt := 1[1];
        }     
  }
}
