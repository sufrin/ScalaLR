
%notation TinyFun
%package  tinyfun
%path     tinyfun
%tables   lr

%include {
  import org.sufrin.scalalr.{SourceLocation,ScannerCore,Scanner}
  import org.sufrin.utility.SourceTextCursor

  /**
     `Scanner(chars)` builds a lexical scanner using a `ScannerBuilder`. The implementations of
     the `mkXXX` functions bridge the fixed lexical categories of the builder, and the `%token`
     constructors declared here. The `withSymbolTokens(symbolToken)` clause initialises the
     internal symbol and token tables of the resulting builder.
  */


      def makeScanner(chars: SourceTextCursor): ScannerCore[Token] = new ScannerCore[Token](chars) {
         def mkString(openQuote: String, closeQuote: String, body: Seq[Char]): Token = STRING(s"$openQuote${body.mkString}$closeQuote")
         def mkHex(source: Seq[Char]):          Token = HEX(source.mkString)
         def mkDec(source: Seq[Char]):          Token = DEC(source.mkString)
         def mkReal(source: Seq[Char]):         Token = REAL(source.mkString)
         def mkIDENTIFIER(source: Seq[Char]):   Token = ID(source.mkString)
         def mkERROR(source: Seq[Char]):        Token = SCANERROR(source.mkString)
         val NEWLINE:                    Option[Token] = Some(NL)
         def flush(): Unit = {
             while (chars.hasCurrent && chars.current != '\n') chars.next()
             print(chars.prompt); System.out.flush()
         }
         locally {
           TinyFun.prompt = chars.promptString
         }
      } withSymbolTokens(symbolToken)




}

%token HEX(Seq[Char]) DEC(Seq[Char]) REAL(Seq[Char]) ID(Seq[Char])  `(` `)` `[` `]` `,` SCANERROR(Seq[Char]) STRING(Seq[Char]) NL "QUIT"
%right `=`
%left `+` `-`
%left `*` `/`
%right `^`
%prec UNARY

%rules

%include {
 import org.sufrin.scalalr.SourceLocation
 import tinyfun.TinyFun._

  def hex(chars: Seq[Char]): Long  = chars.foldLeft(0L) { (acc, c) => acc * 16 + Character.digit(c, 16) }
  def dec(chars: Seq[Char]): Long  = chars.foldLeft(0L) { (acc, c) => acc * 10 + Character.digit(c, 10) }

}

/*
        This is typical of a grammar that performs a parse/run loop as it is parsed.

        The `command` production is a hook that is parsed by parsing an expr sequence, then
        reduced when the NL appears to its right (as the lookahead symbol).
        It is at the reduction that the parsed list of expressions is run.


*/

loop: Unit =
          %empty          { () }
        | loop command NL { () }


command: Unit = expressions   { run($expressions)  }
              | STRING        { println($STRING)   }
              | "QUIT"        { System.exit(0)     }

expr: Expr =
          simple                    { $simple }
        | `-` simple                { Neg($simple, $START) }
        | NAME `=` expr             { Assign($NAME, $expr, $START) }
        | l:expr `^` r:expr         { Binop("^", $l, $r, $START) }
        | l:expr `*` r:expr         { Binop("*", $l, $r, $START) }
        | l:expr `+` r:expr         { Binop("+", $l, $r, $START) }
        | l:expr `/` r:expr         { Binop("/", $l, $r, $START) }
        | l:expr `-` r:expr         { Binop("-", $l, $r, $START) }
        | NAME `(` expressions `)`  { Apply($NAME, $expressions, $START) }
        | `*`  `(` expressions `)`  { Apply("*", $expressions, $START) }
        | `+`  `(` expressions `)`  { Apply("+", $expressions, $START) }
        | `/`  `(` expressions `)`  { Apply("/", $expressions, $START) }

simple: Expr =
          NAME                      { Id($NAME, $START) }
        | NUM                       { Num($NUM, $START) }
        | "(" expr ")"              { $expr }
        | "(" error ")"             { Num(1.0/0.0, $START) }



expressions: List[Expr] = exprs { $exprs.reverse }

exprs: (List[Expr]) =
            expr            { $expr :: Nil }
        |   exprs `,` expr  { $expr :: $exprs }

NUM: Double = HEX  { hex($HEX.toString).toDouble }
            | DEC  { $DEC.toString.toDouble }
            | REAL { $REAL.toString.toDouble }

NAME: String = ID { $ID.toString }

