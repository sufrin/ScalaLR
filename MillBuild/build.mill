package build


/**
    Build the ScalaLR ecosystem:
    1. ./mill ScalaLR.release    -- makes the parser generator
    2. ./mill Runtime.release    -- makes the runtime library
    3. ./mill ApiDocs.release    -- makes a jar of the documentation
*/

import mill.*, scalalib.*

trait ComponentModule extends ScalaModule {
  def scalaVersion   = "2.13.18"
  def scalalrVersion = "1.0.0"
  override def scalacOptions = Seq(
    "-deprecation",
    "-feature",
    "-unchecked"
  )
}

object ScalaLR extends ScalalrModule with ComponentModule  {
  override
  def scalaVersion  = "2.13.18"
  def notation      = "stage3-notation.scalalr"
  def unmanagedJars = "Assets"
  def scalalr       = "Assets/scalalr"
  def mainClass     = Some("org.sufrin.scalalr.stage2.Generator")
  def releasePath   = "bin/scalalr"

  override def moduleDeps = Seq(Shared, Utility)

  // we need the scala xml module
  def mvnDeps = Seq(
      mvn"org.scala-lang.modules::scala-xml:2.3.0"
  )
}

// this module defines classes shared by code generator and scalalr
object Shared extends ComponentModule {
       override def moduleDeps = Seq(Utility)
}

// this module defines classes that (in some sense) useful
object Utility extends ComponentModule {
   override def moduleDeps = Seq(SourceLocation)
    def mvnDeps = Seq(
                mvn"org.scala-lang:scala-reflect:${scalaVersion()}"
        )
}

object SourceLocation extends ComponentModule {
        def mvnDeps = Seq(
                mvn"org.scala-lang:scala-reflect:${scalaVersion()}"
        )
}

// this module depends on scalalr and its runtime
// it defines runnable tests callable from IntelliJ
object Testing extends ComponentModule {
       override def moduleDeps = Seq(ScalaLR, Shared, Utility, SourceLocation)
}

//////////////////////////////////////////////

object Runtime extends ComponentModule {
   override def moduleDeps = Seq(Shared)


   def release() = Task.Command {
         def releasePath: String     = "scalalrruntime.jar"
         def releaseTarget: os.Path  = moduleDir / os.SubPath(releasePath)

         os.makeDir.all(releaseTarget / os.up)

         os.copy.over(
           assembly().path,
           releaseTarget
         )

         os.proc("chmod", "+x", releaseTarget)
         System.err.println(s"Runtime release to $releaseTarget")
         PathRef(releaseTarget)
   }
}

//////////////////////////////////////////////

object ApiDocs extends ComponentModule with UnidocModule {
  def unidocVersion = Some(scalalrVersion)
  def moduleDeps = Seq(ScalaLR)
  def unidocDocumentTitle = "ScalaLR API"
  //def unidocSourceUrl = Some("https://github.com/sufrin/ScalaLR/")

  def make() = Task.Command {
    val site = unidocSite().path.toString
    println(s"Documentation: $site")
  }

  def browse() = Task.Command {
      val site = unidocSite().path
      os.proc("open", site / "index.html").call()
  }

  def release() = Task.Command {
        def runtimeReleasePath = Runtime.release()
        def site   = unidocLocal().path
        def releasePath = "APIDocs.jar"
        def zipped = Task.dest / "APIDocs.jar"
        println(s"zip ${zipped}  ${site}")
        os.zip(zipped, Seq(site))
        def releaseTarget: os.Path = moduleDir / os.SubPath(releasePath)
        os.makeDir.all(releaseTarget / os.up)
         os.copy.over(
           zipped,
           releaseTarget
         )
        PathRef(releaseTarget)
  }
}
